rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Conversation sub-collection: user-scoped
      match /conversations/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Election config is read-only for all authenticated users
    match /election_config/{region} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Cloud Console
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
